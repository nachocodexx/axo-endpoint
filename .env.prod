# =============================================================================
# axo_endpoint — production configuration (all defaults)
# =============================================================================

# --- Identity ----------------------------------------------------------------
AXO_ENDPOINT_ID=axo-endpoint-0

# --- Runtime mode ------------------------------------------------------------
AXO_ENDPOINT_LOCAL_MODE=false

# --- Transport (ZMQ) ---------------------------------------------------------
AXO_ENDPOINT_ROUTER_BIND=tcp://0.0.0.0:5555
AXO_ENDPOINT_PUB_BIND=tcp://0.0.0.0:5556
# Comma-separated list of pub addresses to subscribe to for heartbeats
AXO_ENDPOINT_SUB_CONNECT=

# --- Heartbeat ---------------------------------------------------------------
AXO_ENDPOINT_HEARTBEAT_INTERVAL_SECONDS=5.0
AXO_ENDPOINT_HEARTBEAT_TTL_SECONDS=30.0

# --- Consensus / Replication ---------------------------------------------------
AXO_ENDPOINT_CONSENSUS_REPLICATION_IDLE_SECONDS=2.0
AXO_ENDPOINT_CONSENSUS_REPLICATION_MAX_DIRTY=50
AXO_ENDPOINT_CONSENSUS_FORWARD_TIMEOUT_SECONDS=3.0
AXO_ENDPOINT_ACTIVITY_LOG_MAX_ENTRIES=10000

# --- Queue / Dispatcher ------------------------------------------------------
AXO_ENDPOINT_QUEUE_MAX_DEPTH=1000
# More workers to handle higher concurrent load
AXO_ENDPOINT_QUEUE_WORKERS=8
AXO_ENDPOINT_DEFAULT_MAX_WAIT_SECONDS=-1

# --- Worker Process Runtime --------------------------------------------------
# Recycle idle workers sooner to free resources
AXO_ENDPOINT_WORKER_IDLE_TTL_SECONDS=60.0
AXO_ENDPOINT_WORKER_GC_INTERVAL_SECONDS=30.0
# 0 = unlimited invocations per worker before recycling
AXO_ENDPOINT_WORKER_MAX_INVOCATIONS=0
# Virtual memory limit per worker process (bytes) — 512 MB
AXO_ENDPOINT_WORKER_RLIMIT_AS_BYTES=536870912
AXO_ENDPOINT_WORKER_RLIMIT_CPU_SECONDS=30

# --- Scratch Directories -----------------------------------------------------
AXO_ENDPOINT_SCRATCH_ROOT=/tmp/axo_endpoint/scratch
AXO_ENDPOINT_SCRATCH_GC_INTERVAL_SECONDS=60.0

# --- Data IO -------------------------------------------------------------------
AXO_ENDPOINT_STORAGE_URI=tcp://axo-storage:7000
AXO_ENDPOINT_STORAGE_TOKEN=
AXO_ENDPOINT_STORAGE_TIMEOUT_SECONDS=30.0
AXO_ENDPOINT_STORAGE_ACCESS_RECHECK_SECONDS=5.0
AXO_ENDPOINT_CHUNK_CACHE_MAX_BYTES=1073741824
AXO_ENDPOINT_CHUNK_CACHE_DIR=/tmp/axo_endpoint/chunk-cache
AXO_ENDPOINT_DATAIO_TIMEOUT_SECONDS=30.0

# --- Logging -----------------------------------------------------------------
AXO_ENDPOINT_LOG_LEVEL=DEBUG
AXO_ENDPOINT_LOG_DISABLED=false
AXO_ENDPOINT_LOG_TO_FILE=true
AXO_ENDPOINT_LOG_PATH=.axo_endpoint/log
AXO_ENDPOINT_LOG_FILENAME=axo_endpoint
# Optional: override the full output path for regular logs
AXO_ENDPOINT_LOG_OUTPUT_PATH=
# Optional: override the full output path for error logs
AXO_ENDPOINT_LOG_ERROR_OUTPUT_PATH=
AXO_ENDPOINT_LOG_CONSOLE_LEVEL=DEBUG
AXO_ENDPOINT_LOG_FILE_LEVEL=INFO
AXO_ENDPOINT_LOG_ERROR_FILE=true
AXO_ENDPOINT_LOG_ROTATION_WHEN=midnight
AXO_ENDPOINT_LOG_ROTATION_INTERVAL=1
# Compact JSON for structured log ingestion
AXO_ENDPOINT_LOG_JSON_INDENT=2
AXO_ENDPOINT_LOG_USE_RICH=true
AXO_ENDPOINT_LOG_COLORIZE=true

# --- Container Runtime ---------------------------------------------------------
AXO_ENDPOINT_CONTAINER_NETWORK=axo-net
AXO_ENDPOINT_CONTAINER_MEMORY_LIMIT_BYTES=1073741824
AXO_ENDPOINT_CONTAINER_CPU_LIMIT=1.0

# --- External API publishing ----------------------------------------------------
# Optional: axo_vem ZMQ ingestion address (e.g. tcp://axo-vem:6000).
# Unset/empty = feature fully disabled, zero new behavior.
AXO_ENDPOINT_API_URI=
AXO_ENDPOINT_API_PUBLISH_TIMEOUT_MS=1000
AXO_ENDPOINT_OUTBOX_PATH=.axo_endpoint/outbox
AXO_ENDPOINT_OUTBOX_ACK_TIMEOUT_SECONDS=5.0
AXO_ENDPOINT_OUTBOX_RETRY_BASE_SECONDS=0.5
AXO_ENDPOINT_OUTBOX_RETRY_MAX_SECONDS=30.0
AXO_ENDPOINT_METRICS_BIN_SECONDS=10

# --- VirtualEnvironment membership ----------------------------------------------
# Optional: the VirtualEnvironment (created via axo_vem) this
# endpoint starts assigned to. Unset/empty = unassigned ("alone").
# Reassignment afterward happens at runtime via the VIRTUAL_ENV_ASSIGN
# command sent from axo_vem, not by restarting with a new value.
AXO_ENDPOINT_VIRTUAL_ENV_ID=
AXO_ENDPOINT_OWNER_TYPE=user
AXO_ENDPOINT_OWNER_ID=
AXO_ENDPOINT_CPU_CORES=1.0
AXO_ENDPOINT_MEMORY_MB=1024
AXO_ENDPOINT_RUNNER_BUDGET_ENFORCED=false
AXO_ENDPOINT_RESERVED_CPU_CORES=0.25
AXO_ENDPOINT_RESERVED_MEMORY_MB=256
AXO_ENDPOINT_RUNNER_CGROUP_PARENT=

# --- Cluster-wide container concurrency -----------------------------------------
# How the leader picks among a function's existing owners when placing a
# job that can't grow a new container here. round_robin | random | two_choices
AXO_ENDPOINT_LOAD_BALANCE_STRATEGY=round_robin
# Job result replication (executor -> leader -> every endpoint)
AXO_ENDPOINT_RESULT_REPLICATION_MAX_RETRIES=5
AXO_ENDPOINT_RESULT_KEEP_SECONDS=3600
AXO_ENDPOINT_RESULT_REPLICATION_RETRY_BACKOFF_BASE_SECONDS=1.0
# Leader-owned paginated background re-verification of every job result
AXO_ENDPOINT_RESULT_CONSISTENCY_CHECK_INTERVAL_SECONDS=1800.0
AXO_ENDPOINT_RESULT_CONSISTENCY_CHECK_CHUNK_SIZE=50

# Active objects -- state saved by the leader (memory = lost when the
# leader changes). A VE's endpoints get mongo + redis + axo_storage from
# the VEM (the VE's own Mongo and Redis, created by the Control Plane).
AXO_ENDPOINT_OBJECT_MANIFESTS=memory
AXO_ENDPOINT_OBJECT_HOT=memory
AXO_ENDPOINT_OBJECT_BLOBS=memory
AXO_ENDPOINT_OBJECT_MONGO_URI=
AXO_ENDPOINT_OBJECT_MONGO_DB=axo_objects
AXO_ENDPOINT_OBJECT_REDIS_URI=
AXO_ENDPOINT_OBJECT_BLOB_DIR=/tmp/axo_endpoint/object_blobs
AXO_ENDPOINT_OBJECT_HOT_MAX_BYTES=4096
AXO_ENDPOINT_OBJECT_MAX_STATE_BYTES=0
AXO_ENDPOINT_OBJECT_KEEP_REVISIONS=10
AXO_ENDPOINT_OBJECT_MAX_KEEP_REVISIONS=0
AXO_ENDPOINT_OBJECT_SWEEP_INTERVAL_SECONDS=300.0
AXO_ENDPOINT_OBJECT_SWEEP_GRACE_SECONDS=3600.0
AXO_ENDPOINT_OBJECT_SIZES_INTERVAL_SECONDS=3600.0
