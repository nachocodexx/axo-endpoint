# axo_vem container configuration (production).
# See axo_vem/config.py for the full list of AXO_VEM_*
# settings this project reads -- these are the ones that differ from
# axo_vem/config.py's own defaults for the compose deployment.

AXO_VEM_ROUTER_BIND=tcp://0.0.0.0:6000
AXO_VEM_HTTP_HOST=0.0.0.0
AXO_VEM_HTTP_PORT=8080
AXO_VEM_KURRENT_URI=esdb://kurrentdb:2113?tls=false
AXO_VEM_MONGO_URI=mongodb://axo-vem-mongo:27017
AXO_VEM_MONGO_DB_NAME=axo_vem

AXO_VEM_DB_CONNECT_MAX_ATTEMPTS=10
AXO_VEM_DB_CONNECT_BASE_DELAY_SECONDS=1.0
AXO_VEM_DB_CONNECT_MAX_DELAY_SECONDS=30.0
AXO_VEM_PROJECTOR_STALE_AFTER_SECONDS=60.0


AXO_VEM_ENDPOINT_COMMAND_TIMEOUT_SECONDS=10.0

# DEBUG by default -- show every level out of the box; dial verbosity back
# down per-environment by overriding these three independently (e.g. set to
# INFO or WARNING here for a noisier production deployment).
AXO_VEM_LOG_LEVEL=DEBUG
AXO_VEM_LOG_DISABLED=false
AXO_VEM_LOG_TO_FILE=true
AXO_VEM_LOG_PATH=.axo_vem/log
AXO_VEM_LOG_FILENAME=axo_vem
AXO_VEM_LOG_CONSOLE_LEVEL=DEBUG
AXO_VEM_LOG_FILE_LEVEL=DEBUG
AXO_VEM_LOG_ERROR_FILE=true
AXO_VEM_LOG_ROTATION_WHEN=midnight
AXO_VEM_LOG_ROTATION_INTERVAL=1
# Compact JSON for structured log ingestion
AXO_VEM_LOG_JSON_INDENT=0
AXO_VEM_LOG_USE_RICH=false
AXO_VEM_LOG_COLORIZE=false

# This VEM's VE and the Control Plane's token (set by the CP when it launches
# the VE). axo_storage: choreographies call it as a platform service; every
# endpoint the VEM launches gets its address + this VE's finished token.
AXO_VEM_VE_ID=
AXO_VEM_SERVICE_TOKEN=
AXO_VEM_STORAGE_URI=tcp://axo-storage:7000
AXO_VEM_STORAGE_SERVICE_TOKEN=change-me-vem-service-token
AXO_VEM_NODE_STORAGE_URI=tcp://axo-storage:7000
AXO_VEM_VE_STORAGE_TOKEN=

# Plan limits for this VE (set by the CP from the VE's plan).
AXO_VEM_PLAN_MAX_ENDPOINTS=4
AXO_VEM_PLAN_POLICIES_ALLOWED=true
AXO_VEM_PLAN_MAX_RETENTION_DAYS=30

# Endpoint lifecycle (reconciler) and scaling policies.
AXO_VEM_RECONCILE_INTERVAL_SECONDS=5.0
AXO_VEM_POLICY_INTERVAL_SECONDS=10.0
AXO_VEM_POLICY_PAUSE_AFTER_MANUAL_SECONDS=1800

# The Control Plane link (empty = no CP: job attempts stay in this VEM's log).
AXO_VEM_CP_URI=
AXO_VEM_CP_OUTBOX_PATH=/var/lib/axo_vem/outbox
AXO_VEM_CP_HEARTBEAT_SECONDS=5.0
