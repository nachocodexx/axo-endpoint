# axo_control_plane container configuration (platform compose).
# See axo_control_plane/axo_control_plane/config.py for every AXO_CP_* setting.

AXO_CP_HTTP_HOST=0.0.0.0
AXO_CP_HTTP_PORT=9000
AXO_CP_ROUTER_BIND=tcp://0.0.0.0:9100
# How each VEM reaches this intake (on axo-control-net).
AXO_CP_ROUTER_PUBLIC_URI=tcp://axo-control-plane:9100
AXO_CP_KURRENT_URI=esdb://cp-kurrentdb:2113?tls=false
AXO_CP_MONGO_URI=mongodb://cp-mongo:27017
AXO_CP_MONGO_DB_NAME=axo_control_plane

# ── secrets: replace every change-me value for a real deployment ───────────
# Each VEM's token = HMAC(this, ve id).
AXO_CP_VEM_TOKEN_SECRET=change-me-vem-token-secret
# Must equal axo_storage's AXO_STORAGE_VE_TOKEN_SECRET.
AXO_CP_STORAGE_VE_TOKEN_SECRET=change-me-ve-token-secret
# Must equal axo_storage's AXO_STORAGE_CP_CHECK_TOKEN.
AXO_CP_STORAGE_CHECK_TOKEN=change-me-storage-check-token
# Must be one of axo_storage's AXO_STORAGE_SERVICE_TOKENS (only the CP holds it).
AXO_CP_STORAGE_SERVICE_TOKEN=change-me-cp-storage-service-token
AXO_CP_SDK_KEY_PEPPER=change-me-sdk-key-pepper
# Xolo: the axo account and a CP key with the service, users and acl scopes
# (see xolo-api docs/service-integrations.md for the one-time bootstrap).
AXO_CP_XOLO_URI=http://xolo:10000/api/v4
AXO_CP_XOLO_ACCOUNT_ID=axo-54d425a46124406f8dcf7d202ccaa6ad
AXO_CP_XOLO_API_KEY=XOLO_GKYCDJXNWS8Z6W54Z1AL1ZF85Y2NLUYLRV1F19HAQOW
AXO_CP_XOLO_SCOPE=AXO
# The bootstrap Platform Admin (must change the password at first login).
AXO_CP_ADMIN_USERNAME=admin
AXO_CP_ADMIN_PASSWORD=admin
AXO_CP_ADMIN_EMAIL=admin@example.com

# ── platform ────────────────────────────────────────────────────────────────
AXO_CP_CAPACITY_CPU_CORES=16
AXO_CP_CAPACITY_MEMORY_MB=32768
AXO_CP_STORAGE_URI=tcp://axo-storage:7000
AXO_CP_STORAGE_CONTAINER=axo-storage
AXO_CP_CONTAINER_BACKEND=docker
AXO_CP_CONTROL_NETWORK=axo-control-net
AXO_CP_VEM_IMAGE=axo-vem:local
AXO_CP_ENDPOINT_IMAGE=axo-endpoint:local
AXO_CP_KURRENT_IMAGE=eventstore/eventstore:24.10.0-jammy
AXO_CP_MONGO_IMAGE=mongo:7
AXO_CP_REDIS_IMAGE=redis:8-alpine
AXO_CP_GRACE_DAYS=30
AXO_CP_SLEEP_AFTER_IDLE_SECONDS=1800

AXO_CP_LOG_LEVEL=INFO
AXO_CP_LOG_TO_FILE=false
AXO_CP_LOG_JSON_INDENT=0
AXO_CP_LOG_COLORIZE=false
