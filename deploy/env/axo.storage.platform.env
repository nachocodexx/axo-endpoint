# axo_storage in the platform compose: access questions go to the Control
# Plane. Secrets must match deploy/env/axo.control-plane.prod.env.

AXO_STORAGE_ROUTER_BIND=tcp://0.0.0.0:7000
AXO_STORAGE_WORKERS=8
AXO_STORAGE_BACKEND=fs
AXO_STORAGE_FS_ROOT=/data/chunks
AXO_STORAGE_CATALOG_PATH=/data/catalog.db

# Only the Control Plane holds a service token (VEMs use their VE's token).
AXO_STORAGE_SERVICE_TOKENS=change-me-cp-storage-service-token
AXO_STORAGE_VE_TOKEN_SECRET=change-me-ve-token-secret
AXO_STORAGE_VE_TOKENS=

AXO_STORAGE_ACCESS_MODE=control_plane
AXO_STORAGE_CP_URI=http://axo-control-plane:9000
AXO_STORAGE_CP_CHECK_TOKEN=change-me-storage-check-token
AXO_STORAGE_ACCESS_CACHE_SECONDS=5.0

AXO_STORAGE_LOG_LEVEL=INFO
AXO_STORAGE_LOG_TO_FILE=false
