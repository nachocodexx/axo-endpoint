# axo_storage container configuration (production compose).
# See axo_storage/axo_storage/config.py for every AXO_STORAGE_* setting.

AXO_STORAGE_ROUTER_BIND=tcp://0.0.0.0:7000
AXO_STORAGE_WORKERS=8
AXO_STORAGE_BACKEND=fs
AXO_STORAGE_FS_ROOT=/data/chunks
AXO_STORAGE_CATALOG_PATH=/data/catalog.db

# Credentials until the Control Plane issues them (phase 5). Deployment
# secrets -- replace these dev values for any real deployment; they must
# match AXO_VEM_STORAGE_SERVICE_TOKEN / the HMAC the CP derives into AXO_VEM_VE_STORAGE_TOKEN.
AXO_STORAGE_SERVICE_TOKENS=change-me-vem-service-token
AXO_STORAGE_VE_TOKEN_SECRET=change-me-ve-token-secret
AXO_STORAGE_VE_TOKENS=

# Access rules until the Control Plane answers them (phase 5): "static"
# reads AXO_STORAGE_ACCESS_FILE (bucket creators always own their buckets).
AXO_STORAGE_ACCESS_MODE=static
AXO_STORAGE_ACCESS_FILE=
AXO_STORAGE_ACCESS_CACHE_SECONDS=5.0

AXO_STORAGE_LOG_LEVEL=INFO
AXO_STORAGE_LOG_TO_FILE=false
