# Compose interpolation values for docker-compose.yml (the platform).
# Used by ./deploy.sh (docker compose --env-file deploy/env/compose.env ...).
# Each service's own settings are in its env file under deploy/env/.

# --- axo ----------------------------------------------------------------------
AXO_CP_IMAGE=axo-control-plane:local
AXO_CP_PUBLIC_PORT=9000
AXO_CP_MONGO_IMAGE_TAG=7
AXO_KURRENTDB_IMAGE_TAG=24.10.0-jammy
AXO_STORAGE_IMAGE=axo-storage:local

AXO_UI_IMAGE=axo-ui:local
AXO_UI_PUBLIC_PORT=3080
# Where the browser reaches the Control Plane.
AXO_UI_API_BASE=http://localhost:9000

# Images the Control Plane starts for each VE -- must match AXO_CP_VEM_IMAGE /
# AXO_CP_ENDPOINT_IMAGE in axo.control-plane.prod.env.
AXO_VEM_IMAGE=axo-vem:local
AXO_ENDPOINT_IMAGE=axo-endpoint:local
# Runner image pre-built by `deploy.sh up --build` (a function asking for
# another Python version gets its runner built on first use).
AXO_ENDPOINT_RUNNER_IMAGE=axo-runner
AXO_ENDPOINT_RUNNER_PYTHON_VERSION=3.11

# --- xolo ---------------------------------------------------------------------
XOLO_IMAGE=nachocode/xolo:api-0.1.0a8
XOLO_UI_IMAGE=nachocode/xolo:ui-0.1.0a8
XOLO_VERSION=0.1.0a8
XOLO_API_PUBLIC_PORT=10000
XOLO_UI_PUBLIC_PORT=3001
XOLO_UI_API_BASE=http://localhost:10000/api/v4
XOLO_UVICORN_LOG_LEVEL=info
XOLO_MONGO_IMAGE_TAG=8-noble
XOLO_REDIS_IMAGE_TAG=7.0.11-alpine
