# Local dev (./axo_storage: poetry run python -m axo_storage). Matches the
# endpoints' .env.dev / .env.dev.1 (VE "dev-ve", token "dev-ve-token").
AXO_STORAGE_ROUTER_BIND=tcp://0.0.0.0:7000
AXO_STORAGE_BACKEND=fs
AXO_STORAGE_FS_ROOT=.axo_storage/data
AXO_STORAGE_CATALOG_PATH=.axo_storage/catalog.db
AXO_STORAGE_VE_TOKENS=dev-ve=dev-ve-token
AXO_STORAGE_SERVICE_TOKENS=dev-vem-token
AXO_STORAGE_VE_TOKEN_SECRET=dev-ve-token-secret
# Dev only: everyone may do everything.
AXO_STORAGE_ACCESS_MODE=allow_all
AXO_STORAGE_LOG_LEVEL=DEBUG
